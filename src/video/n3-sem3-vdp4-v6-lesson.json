          "y": 388,
          "size": 52,
          "at": 1
        },
        {
          "kind": "text",
          "value": "ou illimitée et périodique peuvent s’écrire",
          "x": 960,
          "y": 465,
          "size": 52,
          "at": 1,
          "frame": 165
        },
        {
          "kind": "math",
          "value": "\\textsf{sous forme d’une fraction }\\frac{a}{b},",
          "x": 960,
          "y": 575,
          "size": 43,
          "at": 1,
          "frame": 255
        },
        {
          "kind": "math",
          "value": "\\textsf{où }a\\textsf{ et }b\\textsf{ sont deux entiers}",
          "x": 960,
          "y": 711,
          "size": 43,
          "at": 2
        },
        {
          "kind": "math",
          "value": "\\textsf{tels que }b\\ne0,",
