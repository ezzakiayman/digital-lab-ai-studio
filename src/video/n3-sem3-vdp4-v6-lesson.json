          "y": 791,
          "size": 43,
          "at": 2,
          "frame": 401
        },
        {
          "kind": "math",
          "value": "\\textsf{Ils s’appellent des nombres }\\textcolor{#D60019}{\\textsf{rationnels}}.",
          "x": 960,
          "y": 902,
          "size": 43,
          "at": 3
        }
      ],
